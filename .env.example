# Copy this to .env and fill in your values
# NEVER commit .env to git

# ============================================
# API Keys
# ============================================

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_key_here

# Anthropic Claude (Script Generation)
ANTHROPIC_API_KEY=your_key_here

# Google Gemini (Thumbnail Generation - Nano Banana Pro)
GEMINI_API_KEY=your_key_here

# NVD API (optional but recommended - increases rate limit)
NVD_API_KEY=your_key_here

# ============================================
# Airtable (Review Dashboard)
# ============================================

AIRTABLE_API_KEY=your_personal_access_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ============================================
# YouTube (Publishing)
# ============================================

YOUTUBE_CLIENT_ID=your_client_id
YOUTUBE_CLIENT_SECRET=your_client_secret

# ============================================
# Blog (WordPress/Ghost)
# ============================================

BLOG_API_URL=https://yourblog.com/wp-json
BLOG_API_KEY=your_key_here

# ============================================
# Social Media (Optional)
# ============================================

BUFFER_API_KEY=your_key_here
